#!/usr/bin/env bash
# HTTPS の remote への push は gh の active アカウントの認証で通るため、期待のアカウント以外のときは止める。
# 有効化: git config core.hooksPath Scripts/githooks（クローンごとに 1 回）
REMOTE="${1:-}"   # push 先の remote の名前（URL への push では URL）
EXPECTED="${STACKNEST_GH_LOGIN:-shelfsmith}"
unset GITHUB_TOKEN GH_TOKEN
ACTUAL="$(gh api user --jq .login 2>/dev/null || true)"
if [ "$ACTUAL" != "$EXPECTED" ]; then
  echo "pre-push: active gh account is '${ACTUAL:-none}', expected '$EXPECTED'. Push refused." >&2
  exit 1
fi
ROOT="$(git rev-parse --show-toplevel)"
# 標準入力（ref の組）は 1 度しか読めないので、受けてから 3 つの検査に渡す。
REFS="$(cat)"
[ -n "$REFS" ] || exit 0
# 公開のコミットに Claude-Session: の行を残さない（このリポジトリの決まり。CONTRIBUTING.md）。
printf '%s\n' "$REFS" | "$ROOT/Scripts/check-commit-trailers.sh" pre-push "$REMOTE" || exit 1
# 内部の印（内部の作業の番号・計画の文書の名前など。語彙は Scripts/internal-markers.txt）を push しない。
printf '%s\n' "$REFS" | "$ROOT/Scripts/check-internal-markers.sh" pre-push "$REMOTE" || exit 1
# push する ref の名前（ブランチ・タグ。軽量タグも）と、注釈付きタグのメッセージ（コミットの検査では見えない）を、
# 内部の印・個人識別子・Claude-Session: の規則で検査する。タグは ref の名前ではなく、送るオブジェクトの種類で決める
# （`git push <remote> <タグの SHA>:refs/tags/x` も対象）。入れ子のタグは中まで順にたどる。ref の削除は検査しない。
TAGTEXT="$(mktemp -t pre-push-tag)"
trap 'rm -f "$TAGTEXT"' EXIT
ZERO="0000000000000000000000000000000000000000"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue
  printf '%s\n' "$remote_ref" > "$TAGTEXT"
  "$ROOT/Scripts/check-internal-markers.sh" text "$TAGTEXT" || { echo "pre-push: ref name $remote_ref refused." >&2; exit 1; }
  "$ROOT/Scripts/check-private-identifiers.sh" text "$TAGTEXT" || { echo "pre-push: ref name $remote_ref refused." >&2; exit 1; }
  obj="$local_sha"
  while [ "$(git cat-file -t "$obj" 2>/dev/null || true)" = "tag" ]; do
    git cat-file tag "$obj" > "$TAGTEXT" || { echo "pre-push: cannot read the tag object of $remote_ref. Push refused." >&2; exit 1; }
    "$ROOT/Scripts/check-commit-trailers.sh" message "$TAGTEXT" || { echo "pre-push: tag $remote_ref refused." >&2; exit 1; }
    "$ROOT/Scripts/check-internal-markers.sh" text "$TAGTEXT" || { echo "pre-push: tag $remote_ref refused." >&2; exit 1; }
    "$ROOT/Scripts/check-private-identifiers.sh" text "$TAGTEXT" || { echo "pre-push: tag $remote_ref refused." >&2; exit 1; }
    obj="$(sed -n 's/^object //p;q' "$TAGTEXT")"
    [ -n "$obj" ] || { echo "pre-push: cannot follow the tag object of $remote_ref. Push refused." >&2; exit 1; }
  done
done <<< "$REFS"
# 個人識別子（実名など）を push しない。push する各コミットのファイル全体と、新しいコミットのメッセージ・作成者を検査する。
printf '%s\n' "$REFS" | "$ROOT/Scripts/check-private-identifiers.sh" pre-push "$REMOTE"
